        "TargetContact": "Current"
      },
      "Identifier": "No Bloquear Tarjeta",
      "Type": "UpdateContactAttributes",
      "Transitions": {
        "NextAction": "Guardar No Bloqueo",
        "Errors": [{ "NextAction": "Guardar No Bloqueo", "ErrorType": "NoMatchingError" }]
