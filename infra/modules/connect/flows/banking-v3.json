    {
      "Parameters": {
        "Text": "Bienvenido al Banco Demo. Te ayudaremos a revisar tus movimientos y registrar tu reporte. ¿En qué podemos ayudarte?",
        "LexV2Bot": { "AliasArn": "${lex_bot_alias_arn}" }
      },
      "Identifier": "Bienvenida y Obtener Entrada",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "Mensaje Error General",
        "Conditions": [
          { "NextAction": "Get Transactions", "Condition": { "Operator": "Equals", "Operands": ["ReportFraud"] } }
        ],
        "Errors": [
          { "NextAction": "Reintento",          "ErrorType": "NoMatchingCondition" },
          { "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingError" }
        ]
      }
    },

    {
      "Parameters": {
