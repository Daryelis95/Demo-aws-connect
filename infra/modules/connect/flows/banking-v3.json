      "Transitions": {
        "NextAction": "Guardar Respuesta Lambda",
        "Errors": [{ "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "Attributes": {
          "customer_name":  "$.External.customerName",
          "account_id":     "$.External.accountId",
          "card_id":        "$.External.cardId",
          "card_last4":     "$.External.cardLast4",
          "card_reference": "$.External.cardReference",
          "merchant":       "$.External.merchant",
          "amount":         "$.External.amount",
          "currency":       "$.External.currency",
          "suspicious":     "$.External.suspicious",
          "card_status":    "$.External.cardStatus",
          "transaction_id": "$.External.transactionId",
          "operation_id":   "$.External.operationId",
          "success":        "$.External.success"
