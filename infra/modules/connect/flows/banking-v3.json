        "ResponseValidation": { "ResponseType": "STRING_MAP" }
      },
      "Identifier": "Ejecutar Create Fraud Case",
      "Type": "InvokeLambdaFunction",
      "Transitions": {
        "NextAction": "Guardar Datos Caso",
        "Errors": [{ "NextAction": "Guardar Datos Caso", "ErrorType": "NoMatchingError" }]
