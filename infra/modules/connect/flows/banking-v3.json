    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Tu tarjeta terminada en $.Attributes.card_last4 fue bloqueada. Tu reporte quedó registrado. Te comunicamos con un especialista para continuar."
      },
