      "Transitions": {
        "NextAction": "Mensaje Error General",
        "Conditions": [
          { "NextAction": "Ejecutar Bloqueo de Tarjeta", "Condition": { "Operator": "Equals", "Operands": ["ConfirmYes"] } },
          { "NextAction": "No Bloquear Tarjeta",         "Condition": { "Operator": "Equals", "Operands": ["ConfirmNo"] } }
