      "Transitions": {
        "NextAction": "Mensaje Error General",
        "Conditions": [
          { "NextAction": "Validar Transaccion Sospechosa", "Condition": { "Operator": "Equals", "Operands": ["true"] } }
        ],
        "Errors": [{ "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingCondition" }]
      }
    },

    {
      "Parameters": { "ComparisonValue": "$.Attributes.suspicious" },
      "Identifier": "Validar Transaccion Sospechosa",
      "Type": "Compare",
      "Transitions": {
        "NextAction": "Mensaje Error General",
        "Conditions": [
          { "NextAction": "Presentar Compra Sospechosa", "Condition": { "Operator": "Equals", "Operands": ["true"] } }
        ],
        "Errors": [{ "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingCondition" }]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
