      "Identifier": "Guardar No Bloqueo",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Ejecutar Create Fraud Case",
        "Errors": [{ "NextAction": "Ejecutar Create Fraud Case", "ErrorType": "NoMatchingError" }]
      }
    },

