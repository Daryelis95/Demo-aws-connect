      },
      "Identifier": "Confirmar Reconocimiento Compra",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "Mensaje Error General",
        "Conditions": [
          { "NextAction": "Confirmar Compra Reconocida", "Condition": { "Operator": "Equals", "Operands": ["ConfirmYes"] } },
          { "NextAction": "Iniciar Bloqueo Tarjeta",     "Condition": { "Operator": "Equals", "Operands": ["ConfirmNo"] } }
        ],
        "Errors": [
          { "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingError" }
        ]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Perfecto. No realizaremos ningún bloqueo sobre tu tarjeta. Gracias por comunicarte con Banco Demo."
      },
      "Identifier": "Confirmar Compra Reconocida",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "end",
        "Errors": [{ "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "Text": "Por seguridad podemos bloquear la tarjeta terminada en $.Attributes.card_last4. ¿Confirmas que deseas bloquearla?",
