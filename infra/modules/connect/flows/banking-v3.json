      },
      "Identifier": "Mensaje Bloqueo Exitoso Con Caso",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Guardar Contexto Agente Fraud",
        "Errors": [{ "NextAction": "Guardar Contexto Agente Fraud", "ErrorType": "NoMatchingError" }]
      }
