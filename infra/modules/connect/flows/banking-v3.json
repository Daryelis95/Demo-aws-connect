      "Transitions": {
        "NextAction": "Validar Respuesta Lambda",
        "Errors": [{ "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": { "ComparisonValue": "$.Attributes.success" },
