      "Transitions": {
        "NextAction": "Guardar Resultado Bloqueo",
        "Conditions": [
          { "NextAction": "Guardar Resultado Bloqueo", "Condition": { "Operator": "Equals", "Operands": ["BLOCKED"] } },
          { "NextAction": "Guardar Resultado Bloqueo", "Condition": { "Operator": "Equals", "Operands": ["ALREADY_BLOCKED"] } }
        ],
        "Errors": [{ "NextAction": "Guardar Resultado Bloqueo", "ErrorType": "NoMatchingCondition" }]
      }
    },

    {
      "Parameters": {
        "Attributes": {
          "block_result":   "$.External.blockResult",
          "card_reference": "$.External.cardReference",
          "blocked_at":     "$.External.blockedAt",
          "block_success":  "$.External.success"
        },
        "TargetContact": "Current"
      },
      "Identifier": "Guardar Resultado Bloqueo",
      "Type": "UpdateContactAttributes",
      "Transitions": {
        "NextAction": "Ejecutar Create Fraud Case",
        "Errors": [{ "NextAction": "Ejecutar Create Fraud Case", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "Attributes": {
          "block_result":  "NOT_AUTHORIZED",
          "block_success": "true",
          "consent":       "false"
        },
        "TargetContact": "Current"
      },
      "Identifier": "No Bloquear Tarjeta",
      "Type": "UpdateContactAttributes",
      "Transitions": {
        "NextAction": "Guardar No Bloqueo",
        "Errors": [{ "NextAction": "Guardar No Bloqueo", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Entendido. No bloquearemos tu tarjeta. Como indicaste que no reconoces esta compra, registraremos el reporte y te comunicaremos con un especialista."
      },
      "Identifier": "Guardar No Bloqueo",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Ejecutar Create Fraud Case",
        "Errors": [{ "NextAction": "Ejecutar Create Fraud Case", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "LambdaFunctionARN": "${create_fraud_case_lambda_arn}",
        "InvocationTimeLimitSeconds": "7",
        "InvocationType": "SYNCHRONOUS",
        "LambdaInvocationAttributes": {
          "customerId":    "$.Attributes.customer_id",
          "transactionId": "$.Attributes.transaction_id",
          "cardReference": "$.Attributes.card_reference",
          "blockResult":   "$.Attributes.block_result",
          "consent":       "$.Attributes.consent",
          "blockedAt":     "$.Attributes.blocked_at",
          "operationId":   "$.Attributes.operation_id"
        },
        "ResponseValidation": { "ResponseType": "STRING_MAP" }
      },
      "Identifier": "Ejecutar Create Fraud Case",
      "Type": "InvokeLambdaFunction",
      "Transitions": {
        "NextAction": "Guardar Datos Caso",
        "Errors": [{ "NextAction": "Guardar Datos Caso", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "Attributes": {
          "case_id":        "$.External.caseId",
          "case_created":   "$.External.caseCreated",
          "contact_linked": "$.External.contactLinked",
          "case_success":   "$.External.success"
        },
        "TargetContact": "Current"
      },
      "Identifier": "Guardar Datos Caso",
      "Type": "UpdateContactAttributes",
      "Transitions": {
        "NextAction": "Verificar Caso Creado",
        "Errors": [{ "NextAction": "Guardar Contexto Agente Fraud", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": { "ComparisonValue": "$.Attributes.case_success" },
      "Identifier": "Verificar Caso Creado",
      "Type": "Compare",
      "Transitions": {
        "NextAction": "Guardar Contexto Agente Fraud",
        "Conditions": [
          { "NextAction": "Mensaje Bloqueo Exitoso Con Caso", "Condition": { "Operator": "Equals", "Operands": ["true"] } }
        ],
        "Errors": [{ "NextAction": "Guardar Contexto Agente Fraud", "ErrorType": "NoMatchingCondition" }]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Tu tarjeta terminada en $.Attributes.card_last4 fue bloqueada. Tu número de reporte es $.Attributes.case_id. Te comunicamos con un especialista."
      },
      "Identifier": "Mensaje Bloqueo Exitoso Con Caso",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Guardar Contexto Agente Fraud",
        "Errors": [{ "NextAction": "Guardar Contexto Agente Fraud", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Tu tarjeta terminada en $.Attributes.card_last4 fue bloqueada. Tu reporte quedó registrado. Te comunicamos con un especialista."
      },
      "Identifier": "Mensaje Bloqueo Exitoso Sin Caso",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Guardar Contexto Agente Fraud",
        "Errors": [{ "NextAction": "Guardar Contexto Agente Fraud", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "Attributes": {
          "journey_type":     "fraud_v3",
          "transaction_id":   "$.Attributes.transaction_id",
          "card_reference":   "$.Attributes.card_reference",
          "block_result":     "$.Attributes.block_result",
          "case_id":          "$.Attributes.case_id",
          "case_created":     "$.Attributes.case_created",
          "contact_linked":   "$.Attributes.contact_linked",
          "merchant":         "$.Attributes.merchant",
          "amount":           "$.Attributes.amount",
          "currency":         "$.Attributes.currency",
          "operation_id":     "$.Attributes.operation_id",
          "issue_summary":    "Movimiento $.Attributes.amount $.Attributes.currency no reconocido en $.Attributes.merchant",
          "action_completed": "$.Attributes.block_result",
          "pending_request":  "Proceso de disputa"
        },
        "TargetContact": "Current"
      },
      "Identifier": "Guardar Contexto Agente Fraud",
      "Type": "UpdateContactAttributes",
      "Transitions": {
        "NextAction": "Establecer cola de trabajo",
        "Errors": [{ "NextAction": "Establecer cola de trabajo", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "No logramos comprender tu solicitud. Te transferiremos con un especialista para poder ayudarte."
      },
      "Identifier": "Transferencia",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Establecer cola de trabajo",
        "Errors": [{ "NextAction": "Establecer cola de trabajo", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {
        "QueueId": "${fraud_queue_id}"
      },
      "Identifier": "Establecer cola de trabajo",
      "Type": "UpdateContactTargetQueue",
      "Transitions": {
        "NextAction": "transfer-queue",
        "Errors": [{ "NextAction": "Mensaje Error General", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {},
      "Identifier": "transfer-queue",
      "Type": "TransferContactToQueue",
      "Transitions": {
        "NextAction": "end",
        "Errors": [
          { "NextAction": "Mensaje Error General", "ErrorType": "QueueAtCapacity" },
          { "NextAction": "end",                   "ErrorType": "NoMatchingError" }
        ]
      }
    },

    {
      "Parameters": {
        "SkipWhenDTMFBufferEnabled": "false",
        "Text": "Estamos teniendo un inconveniente técnico para procesar tu solicitud. Te transferiremos con un especialista para poder ayudarte."
      },
      "Identifier": "Mensaje Error General",
      "Type": "MessageParticipant",
      "Transitions": {
        "NextAction": "Establecer cola de trabajo",
        "Errors": [{ "NextAction": "Establecer cola de trabajo", "ErrorType": "NoMatchingError" }]
      }
    },

    {
      "Parameters": {},
      "Identifier": "end",
      "Type": "DisconnectParticipant",
      "Transitions": {}
    }

  ]
}
